{
  "name": "legacy-firebase-lockdown",
  "private": true,
  "type": "module",
  "description": "Firestore rules, functions and emulator tests for the live FlutterFlow app. Nothing here deploys itself.",
  "engines": { "node": "22" },
  "scripts": {
    "build:stage1": "node scripts/build-stage1-rules.mjs",
    "test": "firebase emulators:exec --project demo-smartbell --only firestore,auth 'node --test --test-concurrency=1 test/*.test.mjs'",
    "repro": "firebase emulators:exec --project demo-smartbell --only firestore,auth 'node --test --test-concurrency=1 test/repro-deployed.test.mjs'"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "4.0.1",
    "firebase": "11.10.0",
    "firebase-admin": "12.7.0",
    "firebase-tools": "13.35.1"
  }
}
