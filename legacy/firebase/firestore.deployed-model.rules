rules_version = '2';
// MODEL of the rules deployed on 2026-10-31, rebuilt from the screenshot the user
// shared (summarised in docs/roadmap/legacy-firebase-lockdown.md). It is not a copy
// from the live project, and it is here only so the repro test has a baseline.
service cloud.firestore {
  match /databases/{database}/documents {
    match /Users/{uid} {
      allow create: if true;
      allow read: if request.auth != null;
      allow update: if request.auth != null && request.auth.uid == uid;
      allow delete: if false;
    }
    match /Ranches/{id} { allow read, write: if request.auth != null; }
    match /Ranches/{parent}/productionPerDays/{id} { allow read, write: if request.auth != null; }
    match /{path=**}/productionPerDays/{id} { allow read: if request.auth != null; }
    match /Cows_In_Production_change/{id} { allow read, write: if request.auth != null; }
    match /Tasks/{id} { allow read, write: if request.auth != null; }
    match /Cows/{id} { allow read, write: if request.auth != null; }
    match /Bulls/{id} { allow read, write: if request.auth != null; }
    match /CowWeightHeight/{id} { allow read, write: if request.auth != null; }
    match /BullWeightHeight/{id} { allow read, write: if request.auth != null; }
    match /cowProductionPerDay/{id} { allow read, write: if request.auth != null; }
    match /CowsDietChanges/{id} { allow read, write: if request.auth != null; }
    match /CowReproductionState/{id} { allow read, write: if request.auth != null; }
    match /cowHealth/{id} { allow read, write: if request.auth != null; }
    match /BullDietChanges/{id} { allow read, write: if request.auth != null; }
    match /Groups/{id} { allow read, write: if request.auth != null; }
    match /Groups_Bulls/{id} { allow read, write: if request.auth != null; }
    match /Group_cow_changes/{id} { allow read, write: if request.auth != null; }
    match /Group_bull_changes/{id} { allow read, write: if request.auth != null; }
    match /MilkPrices/{id} { allow read, write: if request.auth != null; }
  }
}
