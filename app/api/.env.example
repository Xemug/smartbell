# Copy to .env. ENV=dev fills in the values below when they are empty.
ENV=dev
DATABASE_URL=postgresql+asyncpg://smartbell:smartbell@localhost:5432/smartbell
SECRET_KEY=
# Leave both empty in dev: it uses the demo-smartbell project on the local Auth emulator. The
# emulator host is refused unless the project is a demo- one, because it turns off signature checks.
FIREBASE_PROJECT_ID=
FIREBASE_AUTH_EMULATOR_HOST=
