{
  "$description": "Smartbell design tokens: the single source. Values come from the Smartbell UI Kit (Moon) variables, light mode, plus the domain tokens the kit dropped. `$extensions.figma` names the kit variable; `$extensions.dark` keeps the dark-mode value (dark mode is not shipped in v1). Edit this file, then run `npm run tokens` to regenerate tokens.css. See docs/roadmap/design-tokens.md.",
  "color": {
    "brand": {
      "primary": {
        "$type": "color",
        "$value": "#1460AA",
        "$description": "Primary actions (fill button, active tab, focus ring), links",
        "$extensions": { "figma": "Brand Colors/Primary", "dark": "#1460AA" }
      },
      "secondary": {
        "$type": "color",
        "$value": "#57A7F5",
        "$description": "Light-blue accent",
        "$extensions": { "figma": "Brand Colors/Secondary", "dark": "#57A7F5" }
      },
      "tertiary": {
        "$type": "color",
        "$value": "#BAE5FD",
        "$description": "Pale blue fill",
        "$extensions": { "figma": "Brand Colors/Tertiary", "dark": "#BAE5FD" }
      },
      "alternate": {
        "$type": "color",
        "$value": "#65D9AC",
        "$description": "Brand green, positive accent (not the main CTA)",
        "$extensions": { "figma": "Brand Colors/Alternate", "dark": "#65D9AC" }
      }
    },
    "neutral": {
      "neutral-1": {
        "$type": "color",
        "$value": "#FFFFFF",
        "$description": "Surface",
        "$extensions": { "figma": "Neutral 1", "dark": "#000000" }
      },
      "neutral-2": {
        "$type": "color",
        "$value": "#E2E2E2",
        "$description": "Borders, dividers, disabled background",
        "$extensions": { "figma": "Neutral 2", "dark": "#444444" }
      },
      "neutral-3": {
        "$type": "color",
        "$value": "#757B84",
        "$description": "Muted icons, placeholder",
        "$extensions": { "figma": "Neutral 3", "dark": "#949AA5" }
      },
      "neutral-4": {
        "$type": "color",
        "$value": "#000000",
        "$description": "Maximum-contrast text",
        "$extensions": { "figma": "Neutral 4", "dark": "#FFFFFF" }
      }
    },
    "utility": {
      "primary-background": {
        "$type": "color",
        "$value": "#F9F9F9",
        "$description": "App and page background",
        "$extensions": { "figma": "Primary-background", "dark": "#121212" }
      },
      "secondary-background": {
        "$type": "color",
        "$value": "#EBEBEB",
        "$description": "Sections, input fills",
        "$extensions": { "figma": "Secondary-background", "dark": "#1F1F1F" }
      },
      "primary-text": {
        "$type": "color",
        "$value": "#333333",
        "$description": "Body text",
        "$extensions": { "figma": "Primary-text", "dark": "#E0E0E0" }
      },
      "secondary-text": {
        "$type": "color",
        "$value": "#666666",
        "$description": "Secondary text",
        "$extensions": { "figma": "Secondary-text", "dark": "#AAAAAA" }
      }
    },
    "semantic": {
      "info": {
        "$type": "color",
        "$value": "#57A7F5",
        "$description": "Info",
        "$extensions": { "figma": "Info", "dark": "#57A7F5" }
      },
      "warning": {
        "$type": "color",
        "$value": "#FEC011",
        "$description": "Warning (yellow)",
        "$extensions": { "figma": "Warning", "dark": "#FEC011" }
      },
      "error": {
        "$type": "color",
        "$value": "#EB004E",
        "$description": "Error and danger. Separate from heat, though the kit gives both the same red",
        "$extensions": { "figma": "Error", "dark": "#EB004E" }
      },
      "success": {
        "$type": "color",
        "$value": "#369A73",
        "$description": "Success",
        "$extensions": { "figma": "Success", "dark": "#369A73" }
      }
    },
    "custom": {
      "button-text": {
        "$type": "color",
        "$value": "#FFFFFF",
        "$description": "Text on fill buttons",
        "$extensions": { "figma": "Button-text", "dark": "#FFFFFF" }
      },
      "overlay": {
        "$type": "color",
        "$value": "#2A2A2A1A",
        "$description": "Hover and pressed overlay on top of the base colour",
        "$extensions": { "figma": "Opacity", "dark": "#FFFFFF1A" }
      },
      "scrim": {
        "$type": "color",
        "$value": "#0000008F",
        "$description": "Modal and bottom-sheet backdrop",
        "$extensions": { "figma": "Scrim", "dark": "#0000008F" }
      },
      "primary-60": {
        "$type": "color",
        "$value": "#06366499",
        "$description": "Navy (primary-dark) at 60%",
        "$extensions": { "figma": "Primary-60", "dark": "#06366499" }
      },
      "primary-10": {
        "$type": "color",
        "$value": "#0636641A",
        "$description": "Navy (primary-dark) at 10% (30% in dark mode)",
        "$extensions": { "figma": "Primary-10", "dark": "#0636644D" }
      },
      "info-60": {
        "$type": "color",
        "$value": "#57A7F599",
        "$description": "Info at 60% (re-derived from info, the kit used #4D8FF3)",
        "$extensions": { "figma": "Info-60", "dark": "#57A7F599" }
      },
      "info-10": {
        "$type": "color",
        "$value": "#57A7F51A",
        "$description": "Info at 10%",
        "$extensions": { "figma": "Info-10", "dark": "#57A7F54D" }
      },
      "warning-60": {
        "$type": "color",
        "$value": "#FEC01199",
        "$description": "Warning at 60% (re-derived from warning, the kit used #F4C158)",
        "$extensions": { "figma": "Warning-60", "dark": "#FEC01199" }
      },
      "warning-10": {
        "$type": "color",
        "$value": "#FEC0111A",
        "$description": "Warning at 10%",
        "$extensions": { "figma": "Warning-10", "dark": "#FEC0114D" }
      },
      "error-60": {
        "$type": "color",
        "$value": "#EB004E99",
        "$description": "Error at 60% (re-derived from error, the kit used #F85065)",
        "$extensions": { "figma": "Error-60", "dark": "#EB004E99" }
      },
      "error-10": {
        "$type": "color",
        "$value": "#EB004E1A",
        "$description": "Error at 10%",
        "$extensions": { "figma": "Error-10", "dark": "#EB004E4D" }
      },
      "success-60": {
        "$type": "color",
        "$value": "#369A7399",
        "$description": "Success at 60% (re-derived from success, the kit used #4CCE80)",
        "$extensions": { "figma": "Success-60", "dark": "#369A7399" }
      },
      "success-10": {
        "$type": "color",
        "$value": "#369A731A",
        "$description": "Success at 10%",
        "$extensions": { "figma": "Success-10", "dark": "#369A734D" }
      }
    },
    "domain": {
      "heat": {
        "$type": "color",
        "$value": "#EB004E",
        "$description": "Heat (celo): the Smartbell red. Its own token so it can diverge from error",
        "$extensions": { "dark": "#EB004E" }
      },
      "warning-orange": {
        "$type": "color",
        "$value": "#FF7B01",
        "$description": "Orange for \"Aceptable\" and medium-severity marks",
        "$extensions": { "dark": "#FF7B01" }
      },
      "primary-dark": {
        "$type": "color",
        "$value": "#063664",
        "$description": "Navy: logo background, KPI numerals, pressed states",
        "$extensions": { "dark": "#063664" }
      },
      "success-light": {
        "$type": "color",
        "$value": "#97F6D2",
        "$description": "Light green: slider rail, light marks",
        "$extensions": { "dark": "#97F6D2" }
      }
    }
  },
  "moon": {
    "$description": "Moon semantic aliases, emitted as --<name> RGB channels for @heathmont/moon-core-tw.",
    "piccolo": { "$type": "color", "$value": "{color.brand.primary}" },
    "hit": { "$type": "color", "$value": "{color.brand.alternate}" },
    "goku": { "$type": "color", "$value": "{color.utility.primary-background}" },
    "gohan": { "$type": "color", "$value": "{color.neutral.neutral-1}" },
    "goten": { "$type": "color", "$value": "{color.custom.button-text}" },
    "beerus": { "$type": "color", "$value": "{color.neutral.neutral-2}" },
    "bulma": { "$type": "color", "$value": "{color.utility.primary-text}" },
    "trunks": { "$type": "color", "$value": "{color.utility.secondary-text}" },
    "chichi": { "$type": "color", "$value": "{color.semantic.error}" },
    "krillin": { "$type": "color", "$value": "{color.semantic.warning}" },
    "roshi": { "$type": "color", "$value": "{color.semantic.success}" },
    "whis": { "$type": "color", "$value": "{color.semantic.info}" }
  },
  "font": {
    "display": {
      "$type": "fontFamily",
      "$value": "Montserrat, ui-sans-serif, system-ui, sans-serif",
      "$description": "Display, headline and title styles"
    },
    "body": {
      "$type": "fontFamily",
      "$value": "'Open Sans', ui-sans-serif, system-ui, sans-serif",
      "$description": "Label (buttons) and body styles"
    }
  },
  "typography": {
    "display-lg": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.display}",
        "fontWeight": 700,
        "fontSize": 56,
        "lineHeight": 64,
        "letterSpacing": -1.5
      },
      "$extensions": { "figma": "Display Large" }
    },
    "display-md": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.display}",
        "fontWeight": 700,
        "fontSize": 48,
        "lineHeight": 56,
        "letterSpacing": -1
      },
      "$extensions": { "figma": "Display Medium" }
    },
    "display-sm": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.display}",
        "fontWeight": 700,
        "fontSize": 40,
        "lineHeight": 48,
        "letterSpacing": -0.5
      },
      "$extensions": { "figma": "Display Small" }
    },
    "headline-lg": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.display}",
        "fontWeight": 700,
        "fontSize": 32,
        "lineHeight": 40,
        "letterSpacing": -0.5
      },
      "$extensions": { "figma": "Headline Large" }
    },
    "headline-md": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.display}",
        "fontWeight": 600,
        "fontSize": 24,
        "lineHeight": 32,
        "letterSpacing": 0
      },
      "$extensions": { "figma": "Headline Medium" }
    },
    "headline-sm": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.display}",
        "fontWeight": 700,
        "fontSize": 24,
        "lineHeight": 32,
        "letterSpacing": 0
      },
      "$extensions": { "figma": "Headline Small" }
    },
    "title-lg": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.display}",
        "fontWeight": 600,
        "fontSize": 20,
        "lineHeight": 32,
        "letterSpacing": 0
      },
      "$extensions": { "figma": "Title Large" }
    },
    "title-md": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.display}",
        "fontWeight": 600,
        "fontSize": 18,
        "lineHeight": 28,
        "letterSpacing": 0
      },
      "$extensions": { "figma": "Title Medium" }
    },
    "title-sm": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.display}",
        "fontWeight": 600,
        "fontSize": 16,
        "lineHeight": 24,
        "letterSpacing": 0
      },
      "$extensions": { "figma": "Title Small" }
    },
    "label-lg": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.body}",
        "fontWeight": 600,
        "fontSize": 16,
        "lineHeight": 24,
        "letterSpacing": 0
      },
      "$extensions": { "figma": "Label Large" }
    },
    "label-md": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.body}",
        "fontWeight": 600,
        "fontSize": 14,
        "lineHeight": 22,
        "letterSpacing": 0
      },
      "$extensions": { "figma": "Label Medium" }
    },
    "label-sm": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.body}",
        "fontWeight": 600,
        "fontSize": 12,
        "lineHeight": 18,
        "letterSpacing": 0
      },
      "$extensions": { "figma": "Label Small" }
    },
    "body-lg": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.body}",
        "fontWeight": 400,
        "fontSize": 16,
        "lineHeight": 24,
        "letterSpacing": -0.5
      },
      "$extensions": { "figma": "Body Large" }
    },
    "body-md": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.body}",
        "fontWeight": 400,
        "fontSize": 14,
        "lineHeight": 22,
        "letterSpacing": 0
      },
      "$extensions": { "figma": "Body Medium" }
    },
    "body-sm": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.body}",
        "fontWeight": 400,
        "fontSize": 12,
        "lineHeight": 18,
        "letterSpacing": 0
      },
      "$extensions": { "figma": "Body Small" }
    }
  },
  "typeRamp": {
    "$description": "Responsive roles. Each picks a typography style per tier: sm below 600, md from 600, lg from 960. Body is 16 at every size (farmers in the field). Not in the kit, which has one scale; tiers follow the 2020 library's mobile-to-tablet table.",
    "body": {
      "sm": "{typography.body-lg}",
      "md": "{typography.body-lg}",
      "lg": "{typography.body-lg}"
    },
    "caption": {
      "sm": "{typography.body-sm}",
      "md": "{typography.body-md}",
      "lg": "{typography.body-md}"
    },
    "card-title": {
      "sm": "{typography.title-sm}",
      "md": "{typography.title-md}",
      "lg": "{typography.title-lg}"
    },
    "section-title": {
      "sm": "{typography.title-md}",
      "md": "{typography.headline-sm}",
      "lg": "{typography.headline-sm}"
    },
    "page-title": {
      "sm": "{typography.headline-sm}",
      "md": "{typography.headline-lg}",
      "lg": "{typography.display-sm}"
    },
    "kpi": {
      "sm": "{typography.headline-sm}",
      "md": "{typography.display-sm}",
      "lg": "{typography.display-md}"
    }
  },
  "space": {
    "$description": "4-px base, Tailwind / Moon step names (p-1 = 4).",
    "0": { "$type": "dimension", "$value": 0 },
    "1": { "$type": "dimension", "$value": 4 },
    "2": { "$type": "dimension", "$value": 8 },
    "3": { "$type": "dimension", "$value": 12 },
    "4": { "$type": "dimension", "$value": 16 },
    "5": { "$type": "dimension", "$value": 20 },
    "6": { "$type": "dimension", "$value": 24 },
    "8": { "$type": "dimension", "$value": 32 },
    "10": { "$type": "dimension", "$value": 40 },
    "12": { "$type": "dimension", "$value": 48 }
  },
  "size": {
    "control-xs": { "$type": "dimension", "$value": 26, "$description": "Button xs" },
    "control-sm": { "$type": "dimension", "$value": 30, "$description": "Button sm" },
    "control-md": { "$type": "dimension", "$value": 40, "$description": "Button, input, dropdown" },
    "control-lg": {
      "$type": "dimension",
      "$value": 48,
      "$description": "Large button, main input"
    },
    "control-xl": { "$type": "dimension", "$value": 56, "$description": "Button xl" },
    "icon-sm": { "$type": "dimension", "$value": 16 },
    "icon-md": { "$type": "dimension", "$value": 24, "$description": "Default icon symbol" },
    "icon-lg": { "$type": "dimension", "$value": 32 },
    "app-bar": { "$type": "dimension", "$value": 64 },
    "bottom-nav": { "$type": "dimension", "$value": 70 },
    "side-nav": { "$type": "dimension", "$value": 236 },
    "container": { "$type": "dimension", "$value": 1328 },
    "gutter-sm": { "$type": "dimension", "$value": 16 },
    "gutter-md": { "$type": "dimension", "$value": 24 },
    "gutter-lg": { "$type": "dimension", "$value": 32 }
  },
  "radius": {
    "$description": "Moon names: i- for interactive elements (buttons, inputs, chips), s- for surfaces (cards, sheets, dialogs).",
    "i-xs": { "$type": "dimension", "$value": 4 },
    "i-sm": { "$type": "dimension", "$value": 8, "$description": "Default for buttons and inputs" },
    "i-md": { "$type": "dimension", "$value": 12 },
    "s-xs": { "$type": "dimension", "$value": 4 },
    "s-sm": { "$type": "dimension", "$value": 8 },
    "s-md": { "$type": "dimension", "$value": 12, "$description": "Default for cards" },
    "s-lg": { "$type": "dimension", "$value": 16 },
    "full": { "$type": "dimension", "$value": 9999, "$description": "Pills, switches, discs" }
  },
  "shadow": {
    "sm": {
      "$type": "shadow",
      "$value": "0 0 1px #00000066, 0 6px 6px -6px #00000029",
      "$extensions": { "dark": "0 0 1px #0000008F, 0 6px 6px -6px #000000A3" }
    },
    "md": {
      "$type": "shadow",
      "$value": "0 0 1px #00000033, 0 12px 12px -6px #00000029",
      "$extensions": { "dark": "0 0 1px #0000008F, 0 12px 12px -6px #000000A3" }
    },
    "lg": {
      "$type": "shadow",
      "$value": "0 0 1px #00000066, 0 8px 24px -6px #00000029",
      "$extensions": { "dark": "0 0 1px #0000008F, 0 24px 24px -6px #000000A3" }
    },
    "xl": {
      "$type": "shadow",
      "$value": "0 0 1px #00000033, 0 0 32px -8px #0000001F, 0 32px 32px -8px #00000014",
      "$extensions": { "dark": "0 0 1px #000000B8, 0 48px 48px -6px #000000E0" }
    }
  },
  "breakpoint": {
    "$description": "Min widths. Below md is mobile (designed at 360).",
    "md": { "$type": "dimension", "$value": 600, "$description": "Tablet" },
    "lg": { "$type": "dimension", "$value": 960, "$description": "Small desktop" },
    "xl": { "$type": "dimension", "$value": 1280, "$description": "Desktop: side nav + content" }
  }
}
